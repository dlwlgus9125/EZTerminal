        "relativePath": "src/renderer/TerminalPane.tsx",
        "startLine": 590,
        "endLine": 598,
        "lineDigest": "sha256:7e0a45a9a19a0f6b71da0246acb57141229280fc80cd7522820f0de88bc2ca92",
