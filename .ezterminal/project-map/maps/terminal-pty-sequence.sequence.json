{
  "schemaVersion": 2,
  "id": "terminal-pty-sequence",
  "type": "sequence",
  "title": "Terminal and PTY run sequence",
  "summary": "A command handoff, byte stream, render flush, and cumulative backpressure acknowledgement.",
  "contentLocale": "en",
  "layoutIntent": {
    "density": "balanced",
    "emphasisIds": ["submit-command", "request-port", "dispatch-run", "start-pty", "emit-bytes", "render-bytes", "ack-flush"]
  },
  "chapters": [
    {
      "id": "command-handoff",
      "title": "Command handoff",
      "summary": "The renderer correlates a run before main transfers its dedicated port.",
      "focusIds": ["renderer", "main", "broker", "submit-command", "transfer-port", "dispatch-run"]
    },
    {
      "id": "pty-backpressure",
      "title": "PTY backpressure",
      "summary": "The runtime streams bytes and resumes only after renderer flush acknowledgements.",
      "focusIds": ["runtime", "pty", "emit-bytes", "render-bytes", "ack-flush"]
    }
  ],
  "participants": [
    {
      "id": "renderer",
      "label": "Terminal pane",
      "kind": "surface",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/TerminalPane.tsx",
        "startLine": 578,
        "endLine": 600,
        "lineDigest": "sha256:2ec7eb3628fc84be7e39162a986d916dbcebf19889c51c407f7310abc5935d8b",
        "claim": "TerminalPane registers run correlation before asking preload to submit the command."
      }]
    },
    {
      "id": "main",
      "label": "Main IPC",
      "kind": "service",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/run-command-ipc.ts",
