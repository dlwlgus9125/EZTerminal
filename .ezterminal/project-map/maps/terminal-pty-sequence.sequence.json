      "label": "OS PTY child",
      "kind": "system",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/interpreter/pty-session.ts",
        "startLine": 428,
        "endLine": 464,
        "lineDigest": "sha256:0fe18dd9db987e4aa2e68fecf676a49d410d9728aaaf4a64b49b8c566099f7ae",
        "claim": "PtySession observes child bytes, updates terminal modes, emits frames, and applies high-water pausing."
      }]
    }
  ],
  "messages": [
