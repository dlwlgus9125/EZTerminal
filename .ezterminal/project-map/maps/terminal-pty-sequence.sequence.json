      }]
    },
    {
      "id": "ack-flush",
      "from": "renderer",
      "to": "pty",
      "label": "cumulative pty-ack",
      "kind": "return",
      "order": 7,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/interpreter/pty-session.ts",
        "startLine": 520,
        "endLine": 532,
        "lineDigest": "sha256:fdfe328190b08954d0492f3e32321a9a02ee08672b1eb8cf167e9966c139548d",
