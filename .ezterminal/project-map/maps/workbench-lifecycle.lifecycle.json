{
  "schemaVersion": 2,
  "id": "workbench-lifecycle",
  "type": "lifecycle",
  "title": "Workbench persistence lifecycle",
  "summary": "How a persisted layout is sanitized, restored, operated, checkpointed, recovered, and drained.",
  "contentLocale": "en",
  "layoutIntent": {
    "density": "balanced",
    "emphasisIds": ["persisted", "validating", "restoring", "ready", "checkpointed", "recovering", "closed"]
  },
  "chapters": [
    {
      "id": "safe-restore",
      "title": "Safe restore",
      "summary": "Disk input is sanitized and validated before Dockview receives it.",
      "focusIds": ["persisted", "validating", "restoring", "validate-layout", "restore-layout"]
    },
    {
      "id": "crash-recovery",
      "title": "Crash recovery",
      "summary": "Active surface checkpoints allow a renderer replacement to recover bounded UI state.",
      "focusIds": ["ready", "checkpointed", "recovering", "capture-checkpoint", "renderer-replaced"]
    },
    {
      "id": "clean-shutdown",
      "title": "Clean shutdown",
      "summary": "The app flushes the current layout before runtime owners are disposed.",
      "focusIds": ["ready", "closed", "quit-and-flush"]
    }
  ],
  "phases": [
    { "id": "disk", "label": "Persisted input" },
    { "id": "startup", "label": "Startup transaction" },
    { "id": "active", "label": "Active workbench" },
    { "id": "recovery", "label": "Renderer recovery" },
    { "id": "shutdown", "label": "Shutdown" }
  ],
  "states": [
    {
      "id": "persisted",
      "label": "Layout on disk",
      "detail": "A versioned envelope contains bounded known panel data.",
      "kind": "initial",
      "phase": "disk",
      "order": 0,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/layout-store.ts",
        "startLine": 83,
        "endLine": 107,
        "lineDigest": "sha256:41a63dd299e5207d7b8c7b08e46848e2a8dd940f1ff5964097b2736a6bd813aa",
        "claim": "LayoutStore reads and writes versioned layout envelopes through its owned file primitive."
      }]
    },
    {
      "id": "validating",
      "label": "Sanitizing and validating",
      "detail": "Unknown or unsafe panel payloads fail before Dockview restoration.",
      "kind": "transient",
      "phase": "startup",
      "order": 0,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/shared/layout-schema.ts",
        "startLine": 393,
        "endLine": 486,
        "lineDigest": "sha256:2ce861079e37d426f870ea861b8967254675d58a93c3c7e769099dd51848850d",
        "claim": "sanitizeSerializedLayout removes unsupported buckets and normalizes known panel payloads before validation."
      }]
    },
    {
      "id": "restoring",
      "label": "Atomic restore transaction",
      "detail": "Restore is generation-guarded and can fall back without exposing partial state.",
      "kind": "transient",
      "phase": "startup",
      "order": 1,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/workbench-coordinator.ts",
        "startLine": 350,
        "endLine": 401,
        "lineDigest": "sha256:527ee02d8948558add9ec49b9a53117e7cc636cd4c1aaa98f376c075aaafeed9",
        "claim": "WorkbenchCoordinator restores within a transaction and handles failed or zero-panel restoration."
      }]
    },
    {
      "id": "ready",
      "label": "Interactive workbench",
      "detail": "Dockview panels are live and later layout changes are scheduled for persistence.",
      "kind": "steady",
      "phase": "active",
      "order": 0,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/App.tsx",
        "startLine": 3445,
        "endLine": 3459,
        "lineDigest": "sha256:8b421e60bdc6e5e3bf9c5988ba5ee9e18064f217cfb6a186496f535aca29c00b",
        "claim": "The app attaches persistence listeners only after startup restoration settles."
      }]
    },
    {
      "id": "checkpointed",
      "label": "Recovery checkpoint captured",
      "detail": "A bounded checkpoint records restorable panel and run identities.",
      "kind": "steady",
      "phase": "recovery",
      "order": 0,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/App.tsx",
        "startLine": 3409,
        "endLine": 3417,
        "lineDigest": "sha256:a02cb05c616b1ef9d4ed9d9fb9695603efbfbf7ca8d14f2d985223f47e2fc24e",
        "claim": "Layout and active-panel changes schedule renderer recovery checkpoints."
      }]
    },
    {
      "id": "recovering",
      "label": "Renderer replacement",
      "detail": "Main consumes one checkpoint for the replacement renderer generation.",
      "kind": "transient",
      "phase": "recovery",
      "order": 1,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/renderer-recovery-checkpoint-store.ts",
        "startLine": 1,
        "endLine": 58,
        "lineDigest": "sha256:cc3365070c62de75c528788c3c63d20d44e22db5abb41a00fdcdafed42d99714",
        "claim": "The main-owned checkpoint store saves, consumes, and bounds renderer recovery state per sender."
      }]
    },
    {
      "id": "closed",
      "label": "Flushed and disposed",
      "detail": "Layout persistence and runtime shutdown complete under one bounded coordinator.",
      "kind": "terminal",
      "phase": "shutdown",
      "order": 0,
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/main.ts",
        "startLine": 2275,
        "endLine": 2404,
        "lineDigest": "sha256:10d666b820e7485411c130e1edf8ee42c6ecd69addf61a850a4e72b46c7f5f02",
        "claim": "Graceful shutdown flushes layout and disposes owned services under a deadline."
      }]
    }
  ],
  "transitions": [
    {
      "id": "validate-layout",
      "from": "persisted",
      "to": "validating",
      "label": "read envelope",
      "kind": "primary",
      "event": "app starts",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/shared/layout-schema.ts",
        "startLine": 488,
        "endLine": 510,
        "lineDigest": "sha256:dbd73c101a9126b3d120ad68af6527a8a35a2d9988aa4ca67dcf1a79e8693e1b",
        "claim": "The full validation pipeline sanitizes and parses the envelope before applying invariants."
      }]
    },
    {
      "id": "restore-layout",
      "from": "validating",
      "to": "restoring",
      "label": "begin restore",
      "kind": "primary",
      "event": "validation passes",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/workbench-coordinator.ts",
        "startLine": 361,
        "endLine": 380,
        "lineDigest": "sha256:ff0261170da325e871b7d1ca3d68f37ac50e5dc9bc9ef1cc94c7d22aad552050",
        "claim": "A validated envelope is passed to the adapter restore path with fallback protection."
      }]
    },
    {
      "id": "restore-complete",
      "from": "restoring",
      "to": "ready",
      "label": "publish workbench",
      "kind": "primary",
      "event": "restore commits",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/App.tsx",
        "startLine": 3445,
        "endLine": 3459,
        "lineDigest": "sha256:8b421e60bdc6e5e3bf9c5988ba5ee9e18064f217cfb6a186496f535aca29c00b",
        "claim": "After restore settles, the app attaches save listeners and persists the resulting state."
      }]
    },
    {
      "id": "capture-checkpoint",
      "from": "ready",
      "to": "checkpointed",
      "label": "capture bounded state",
      "kind": "secondary",
      "event": "workspace changes",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/App.tsx",
        "startLine": 3409,
        "endLine": 3417,
        "lineDigest": "sha256:a02cb05c616b1ef9d4ed9d9fb9695603efbfbf7ca8d14f2d985223f47e2fc24e",
        "claim": "Both layout and active-panel events feed the checkpoint scheduler."
      }]
    },
    {
      "id": "continue-after-checkpoint",
      "from": "checkpointed",
      "to": "ready",
      "label": "continue normally",
      "kind": "secondary",
      "event": "renderer healthy",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/renderer-recovery-checkpoint-store.ts",
        "startLine": 20,
        "endLine": 43,
        "lineDigest": "sha256:b9790632909b57c708f4db0fe020439cc194b2803ec507ec5f908aba4383a4b9",
        "claim": "Saving a checkpoint does not consume it or interrupt the active renderer."
      }]
    },
    {
      "id": "renderer-replaced",
      "from": "checkpointed",
      "to": "recovering",
      "label": "consume checkpoint",
      "kind": "error",
      "event": "renderer crashes",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/main.ts",
        "startLine": 1978,
        "endLine": 1986,
        "lineDigest": "sha256:e49f13b5b6411dc62fe43bc018f2acbc64e0a7c32ca4dcef829e7091cab9c7c1",
        "claim": "Main exposes save, consume, and prepare recovery IPC for renderer replacement."
      }]
    },
    {
      "id": "recovery-complete",
      "from": "recovering",
      "to": "ready",
      "label": "restore live surfaces",
      "kind": "primary",
      "event": "replacement ready",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/renderer/App.tsx",
        "startLine": 630,
        "endLine": 645,
        "lineDigest": "sha256:0fa4dbc73e891660215a38746ff0e475b4f7a89d888ce393a75d5f7df070e6dd",
        "claim": "A replacement renderer consumes the recovery seed before normal checkpoint scheduling resumes."
      }]
    },
    {
      "id": "quit-and-flush",
      "from": "ready",
      "to": "closed",
      "label": "flush and dispose",
      "kind": "primary",
      "event": "app quits",
      "evidence": [{
        "rootAlias": "app",
        "relativePath": "src/main/main.ts",
        "startLine": 2275,
        "endLine": 2404,
        "lineDigest": "sha256:10d666b820e7485411c130e1edf8ee42c6ecd69addf61a850a4e72b46c7f5f02",
        "claim": "The shutdown task list flushes renderer layout before disposing runtime owners."
      }]
    }
  ],
  "initialState": "persisted"
}
